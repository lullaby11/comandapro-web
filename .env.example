# ─────────────────────────────────────────────────────────────────────────────
# ComandaPro / Olyda — variables de entorno de ejemplo
#
#   cp .env.example apps/api/.env          (backend)
#   cp .env.example apps/web/.env.local    (solo las NEXT_PUBLIC_*)
#
# NUNCA subas a git un fichero con valores reales.
# ─────────────────────────────────────────────────────────────────────────────

# ── API (apps/api) ───────────────────────────────────────────────────────────
# Obligatorias: la API no arranca sin ellas
DATABASE_URL="postgresql://comandapro:comandapro@localhost:5432/comandapro_dev?schema=public"
JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
# URL PÚBLICA DEL FRONTEND (no de la API): se usa en el QR del ticket y en los emails
APP_URL="http://localhost:3000"

# Opcionales
PORT=4000
NODE_ENV=development
JWT_EXPIRES_IN=7d
# Lista blanca de orígenes CORS separados por comas (pendiente de aplicarse en el código)
ALLOWED_ORIGINS="http://localhost:3000"

# ── Email (apps/api) ─────────────────────────────────────────────────────────
# Transporte: "ses" | "smtp" | "log". Si no se indica, se deduce: SES_REGION → ses,
# SMTP_HOST → smtp, y si no hay nada → log (vuelca el correo y sus enlaces por consola).
# En desarrollo lo normal es dejarlo sin configurar y usar el modo log.
# MAIL_TRANSPORT="log"

# Remitente. El nombre visible lo pone la aplicación con el del local:
#   "Pizzería Bella Italia vía Olyda" <no-reply@olyda.app>
MAIL_FROM_ADDRESS="no-reply@olyda.app"
MAIL_FROM_BRAND="Olyda"
# Buzón atendido al que llegan las respuestas de los clientes. Opcional.
MAIL_REPLY_TO=""

# --- Opción A: Amazon SES (la de producción) ---
# Sin credenciales: en AWS se autoriza con el rol de instancia de App Runner.
# En local necesitarías credenciales de AWS con permiso ses:SendEmail.
# SES_REGION="eu-west-3"

# --- Opción B: SMTP clásico (para despliegues fuera de AWS) ---
# SMTP_HOST="smtp.tu-proveedor.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""

# ── Frontend (apps/web/.env.local) ───────────────────────────────────────────
# Se leen EN TIEMPO DE BUILD y quedan incrustadas en el bundle: son públicas.
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Agente de impresión (apps/print-agent/.env) ──────────────────────────────
PRINT_AGENT_API_URL="http://localhost:4000"
PRINT_AGENT_EMAIL="admin@pizzeria-bella.com"
PRINT_AGENT_PASSWORD="admin1234"
PRINT_AGENT_BUSINESS_SLUG="pizzeria-bella"
PRINT_AGENT_POLL_INTERVAL_MS=5000
# Nombre de la cola en CUPS — averígualo con: lpstat -p
PRINTER_NAME="Printer_USB_Printer_P"
