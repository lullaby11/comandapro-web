// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// TENANT: Business (Local / Restaurante)
// ─────────────────────────────────────────────
model Business {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  logoUrl        String?
  phone          String?
  address        String?
  // Configuración de impresión
  paperWidth     Int      @default(80)        // 58 o 80 mm
  printerMode    String   @default("webusb")  // "webusb" | "printserver"
  printServerUrl String?                      // URL del agente local si printerMode = "printserver"
  // Configuración de la comanda
  currency       String   @default("EUR")
  taxRate        Float    @default(0)         // % de IVA
  // Venta online
  onlineOrderEnabled Boolean @default(false)
  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relaciones
  users            BusinessUser[]
  invitations      TeamInvitation[]
  products         Product[]
  customers        Customer[]
  orders           Order[]
  shippingRates    ShippingRate[]
  services         Service[]
  customerAccounts CustomerAccount[]

  @@map("businesses")
}

// ─────────────────────────────────────────────
// USUARIOS por tenant
// ─────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  businesses BusinessUser[]

  @@map("users")
}

model BusinessUser {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  role       Role     @default(STAFF)
  createdAt  DateTime @default(now())
  // Desactivar en lugar de borrar: mantiene el rastro de quién trabajó en el local.
  // El middleware de autenticación rechaza el acceso si está desactivado.
  disabledAt DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("business_users")
}

// ─────────────────────────────────────────────
// INVITACIONES DE EQUIPO
// ─────────────────────────────────────────────
// Hasta v1.1 el único usuario que existía era el OWNER creado en el registro: dar de
// alta a un empleado obligaba a tocar la base de datos a mano.
model TeamInvitation {
  id         String    @id @default(cuid())
  businessId String
  email      String
  role       Role      @default(STAFF)
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  invitedBy  String
  createdAt  DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Una invitación viva por email y local; las aceptadas o caducadas se pueden reemplazar
  @@unique([businessId, email])
  @@index([businessId])
  @@index([token])
  @@map("team_invitations")
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

// ─────────────────────────────────────────────
// PRODUCTOS (con stock por tenant)
// ─────────────────────────────────────────────
model Product {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  imageUrl    String?
  category    String?
  active         Boolean  @default(true)
  onlineVisible  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([businessId])
  @@index([businessId, active])
  @@map("products")
}

// ─────────────────────────────────────────────
// CLIENTES (por tenant, buscables por teléfono)
// ─────────────────────────────────────────────
model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String
  email      String?
  address    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders   Order[]

  // Un teléfono es único por local
  @@unique([businessId, phone])
  @@index([businessId, phone])
  @@map("customers")
}

// ─────────────────────────────────────────────
// PEDIDOS
// ─────────────────────────────────────────────
model Order {
  id            String        @id @default(cuid())
  businessId    String
  customerId    String
  serviceId     String?
  trackingToken       String        @unique @default(cuid())
  status              OrderStatus   @default(PENDING)
  customerAccountId   String?
  total         Decimal       @db.Decimal(10, 2)
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @db.Decimal(10, 2) @default(0)
  shippingCost  Decimal       @db.Decimal(10, 2) @default(0)
  shippingRateId String?
  notes               String?
  isPickup            Boolean       @default(false)
  deliveryAddress     String?
  estimatedDeliveryAt DateTime?
  paymentMethod       PaymentMethod @default(CASH)
  cashGiven           Decimal?      @db.Decimal(10, 2)
  printedAt           DateTime?
  // Marca de que el stock de este pedido ya volvió al inventario, al cancelarlo o al
  // borrarlo. Evita devolverlo dos veces si se encadenan ambas acciones.
  stockRestoredAt     DateTime?
  // Borrado lógico: un pedido borrado desaparece de listados y estadísticas, pero deja
  // rastro de quién lo borró y cuándo. Antes se borraba físicamente y se perdía el
  // histórico contable, además de alterar las estadísticas de forma retroactiva.
  deletedAt           DateTime?
  deletedBy           String?
  createdAt           DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer         @relation(fields: [customerId], references: [id])
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id])
  items           OrderItem[]
  shippingRate    ShippingRate?    @relation(fields: [shippingRateId], references: [id])
  service         Service?         @relation(fields: [serviceId], references: [id])

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, serviceId])
  // El listado de pedidos y las estadísticas por periodo ordenan y filtran por fecha
  @@index([businessId, createdAt])
  @@index([trackingToken])
  @@map("orders")
}

// ─────────────────────────────────────────────
// SERVICIOS (turnos de trabajo)
// ─────────────────────────────────────────────
model Service {
  id         String    @id @default(cuid())
  businessId String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  createdAt  DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([businessId])
  @@map("services")
}

// ─────────────────────────────────────────────
// TARIFAS DE ENVÍO (por tenant)
// ─────────────────────────────────────────────
model ShippingRate {
  id         String   @id @default(cuid())
  businessId String
  name       String
  price      Decimal  @db.Decimal(10, 2)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([businessId])
  @@map("shipping_rates")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
  notes     String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

enum OrderStatus {
  RECEIVED_ONLINE  // Recibido por venta online (pendiente de aceptar)
  PENDING          // Recibido / aceptado
  PREPARING        // En cocina
  READY            // Listo para entregar
  OUT_FOR_DELIVERY // En reparto (solo domicilio)
  DELIVERED        // Entregado
  CANCELLED        // Cancelado
}

enum PaymentMethod {
  CASH  // Efectivo
  CARD  // Tarjeta
}

// ─────────────────────────────────────────────
// CUENTAS DE CLIENTES (venta online)
// ─────────────────────────────────────────────
model CustomerAccount {
  id              String    @id @default(cuid())
  businessId      String
  name            String
  phone           String
  email           String
  passwordHash    String
  address         String
  emailVerified   Boolean   @default(false)
  verifyToken     String?   @unique
  verifyExpiresAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@unique([businessId, email])
  @@index([businessId])
  @@map("customer_accounts")
}
