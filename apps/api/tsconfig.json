{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "baseUrl": "."
  },
  "include": ["src/**/*"],
  // Los tests no se compilan a dist: no deben viajar en la imagen de producción.
  // Para comprobar sus tipos existe tsconfig.test.json.
  "exclude": ["node_modules", "dist", "prisma", "src/**/__tests__/**", "vitest.config.ts"]
}
