{
  // Comprobación de tipos de los tests, que el tsconfig de build excluye para que no
  // acaben en la imagen de producción. Solo verifica: no emite nada.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "prisma"]
}
